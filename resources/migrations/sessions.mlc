# ═══════════════════════════════════════════════════════════════════════════════
# MonkeysCMS — Sessions Migration
# resources/migrations/sessions.mlc
#
# Database-backed session storage. Replaces file-based sessions to avoid
# orphan files from cookieless requests (sendBeacon, bots, etc.).
# Schema matches MonkeysLegion Session DatabaseDriver expectations.
# ═══════════════════════════════════════════════════════════════════════════════

table "sessions" {
    session_id    = { type = "string", length = 128, primary = true }
    payload       = { type = "text" }
    last_activity = { type = "unsignedInt" }
    expiration    = { type = "unsignedInt", nullable = true }
    created_at    = { type = "unsignedInt", nullable = true }
    user_id       = { type = "bigint", nullable = true }
    ip_address    = { type = "string", length = 45, nullable = true }
    user_agent    = { type = "text", nullable = true }
    flash_data    = { type = "text", nullable = true }

    index "idx_sessions_user"          = ["user_id"]
    index "idx_sessions_last_activity" = ["last_activity"]
    index "idx_sessions_expiration"    = ["expiration"]
}

# ── Rollback ───────────────────────────────────────────────────────────────────
rollback "sessions" {
    drop_table = "sessions"
}
