# ═══════════════════════════════════════════════════════════════════
# Article Content Type
# config/content-types/article.mlc
# ═══════════════════════════════════════════════════════════════════

content_type "article" {
    label        = "Article"
    label_plural = "Articles"
    description  = "News articles, blog posts, and editorial content"
    icon         = "newspaper"

    publishable    = true
    revisionable   = true
    has_author     = true
    has_taxonomy   = true
    has_media      = true
    mosaic_enabled = true
    mosaic_default = false
    url_pattern    = "/blog/{slug}"

    fields {
        field "summary" {
            type     = "text"
            label    = "Summary"
            widget   = "textarea"
            required = false
            weight   = 0
            help_text = "A brief summary displayed in content lists"
        }
        field "category" {
            type     = "taxonomy"
            label    = "Category"
            widget   = "taxonomy_select"
            required = false
            weight   = 1
            settings {
                vocabulary = "categories"
            }
        }
        field "tags" {
            type     = "taxonomy"
            label    = "Tags"
            widget   = "taxonomy_select"
            required = false
            weight   = 2
            settings {
                vocabulary = "tags"
                multiple   = true
            }
        }
    }
}
