# ===========================
/.phpunit.cache/
/phpunit.result.cache
/coverage/
.phpunit.result.cache
/.phpunit.result.cache

# ===========================
# PHPStan
# ===========================
/var/cache/phpstan/
phpstan.neon.dist

# ===========================
