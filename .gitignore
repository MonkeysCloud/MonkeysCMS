# ===========================
# Composer (PHP)
# ===========================
/vendor/
composer.lock

# ===========================
# Node / NPM
# ===========================
/node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*
yarn.lock
pnpm-lock.yaml

# ===========================
# Build & Distribution
# ===========================
/build/
/dist/
/public/build/
/*.phar

# ===========================
# Logs
# ===========================
*.log
/var/log/*
!/var/log/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# ===========================
# Cache & Runtime
# ===========================
/var/cache/*
!/var/cache/.gitkeep
/var/sessions/*
!/var/sessions/.gitkeep
/var/migrations/*
!/var/migrations/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/framework/*
!/storage/framework/.gitkeep

# ===========================
# Environment files
# ===========================
.env
.env.*.local
.env.local
.env.testing
.env.production

