# ═══════════════════════════════════════════════════════════════════════════════
# SEO Toolkit — MonkeysCMS Plugin
# plugins/contrib/monkeyscloud/seo-toolkit/seo-toolkit.plugin.mlc
#
# Enterprise SEO plugin for MonkeysCMS:
#   - Injects meta description + Open Graph tags into content output
#   - Adds SEO fields to content edit form via hooks
#   - Configurable default OG image
#   - Reference implementation for the plugin system
# ═══════════════════════════════════════════════════════════════════════════════

plugin {
    name        = "seo-toolkit"
    vendor      = "monkeyscloud"
    version     = "1.0.0"
    description = "Enterprise SEO: meta tags, Open Graph, Twitter Cards, and structured data"
    author      = "MonkeysCloud"
    namespace   = "MonkeysCloud\\SeoToolkit"
    provider    = "MonkeysCloud\\SeoToolkit\\SeoToolkitPlugin"
    requires    = ["core:>=2.0.0"]
    core        = "2.x"
}

# ── Plugin Settings ──────────────────────────────────────────────────────────
settings {
    default_og_image = { type = "string", label = "Default OG Image URL", default = "" }
    twitter_handle   = { type = "string", label = "Twitter @handle", default = "" }
    site_name        = { type = "string", label = "Site Name (for OG)", default = "MonkeysCMS" }
    enable_jsonld    = { type = "boolean", label = "Enable JSON-LD structured data", default = true }
    robots_default   = { type = "string", label = "Default robots meta", default = "index, follow" }
}
