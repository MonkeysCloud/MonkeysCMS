# ═══════════════════════════════════════════════════════════════════════════════
# MonkeysCMS — Core Admin Theme
# themes/core/admin/theme.mlc
#
# This is a BASE THEME for the admin interface. Custom admin themes
# can extend this by setting:
#   base_theme = "admin"
# ═══════════════════════════════════════════════════════════════════════════════

theme {
    name        = "admin"
    label       = "MonkeysCMS Admin"
    description = "Default administration base theme for MonkeysCMS"
    version     = "1.0.0"
    type        = "admin"

    # No parent — this is a root base theme
    base_theme = null

    # Admin regions
    regions = [
        "header",
        "sidebar",
        "content",
        "footer",
        "messages",
        "breadcrumb",
        "actions"
    ]

    # Global libraries this theme attaches
    # NOTE: core/monkeysjs and core/icons are required=true (always loaded).
    # Component styles (forms, buttons, etc.) are baked into admin.css.
    libraries = [
        "core/monkeysjs",
        "core/icons"
    ]

    # Theme-specific assets (CSS loaded by layout via Vite manifest)
    assets {
        css = []
        js = [
            "js/admin.js",
            "js/form-engine.js"
        ]
    }
}

# ─── Mosaic Page Builder Library ────────────────────────────────────────────
# Loaded only on the mosaic editor page via @push directives or explicit attach.
library "admin/mosaic" {
    description  = "Mosaic visual page builder editor"
    css          = ["css/mosaic.css"]
    js           = ["js/mosaic-editor.js"]
    weight       = 20
    dependencies = ["core/monkeysjs", "core/icons"]
}

# ─── Media Browser Library ──────────────────────────────────────────────────
# Loaded on content edit pages and the media library for the picker modal.
library "admin/media-browser" {
    description  = "Media picker modal with AJAX upload and grid selection"
    css          = []
    js           = ["js/media-browser.js"]
    weight       = 25
    dependencies = ["core/monkeysjs", "core/icons"]
}

